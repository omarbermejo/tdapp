{
  "expo": {
    "name": "tdapp",
    "slug": "tdapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "tdapp",
      "com.tdapp.tdapp"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tdapp.tdapp",
      "usesAppleSignIn": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.tdapp.tdapp",
      "adaptiveIcon": {
        "backgroundColor": "#fefae0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fefae0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tdapp.tdapp.widgets",
          "groupIdentifier": "group.com.tdapp.tdapp",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Tu día",
              "description": "Lo que sigue hoy y cuánto te queda.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "FocusWidget",
              "displayName": "Enfoque",
              "description": "El bloque de enfoque en curso, con la cuenta atrás.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "StreakWidget",
              "displayName": "Racha",
              "description": "Cuántos días seguidos cerraste algo.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "CaptureWidget",
              "displayName": "Anotar",
              "description": "Anota algo en un toque, sin abrir la app.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            }
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
