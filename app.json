{
  "expo": {
    "name": "tdapp",
    "slug": "tdapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "tdapp",
      "com.tdapp.tdapp"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tdapp.tdapp",
      "usesAppleSignIn": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.tdapp.tdapp",
      "adaptiveIcon": {
        "backgroundColor": "#fefae0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fefae0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tdapp.tdapp.widgets",
          "groupIdentifier": "group.com.tdapp.tdapp",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Tu d\u00eda",
              "description": "Lo que sigue hoy y cu\u00e1nto te queda.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
