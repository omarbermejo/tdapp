{
  "expo": {
    "name": "tdapp",
    "slug": "tdapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": [
      "tdapp",
      "com.tdapp.tdapp"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tdapp.tdapp",
      "usesAppleSignIn": true,
      "icon": "./assets/brand/icon.png",
      "appleTeamId": "BXQ4VVHV9L",
      "infoPlist": {
        "NSCameraUsageDescription": "Para leer el código QR de una invitación a un espacio de trabajo."
      }
    },
    "android": {
      "package": "com.tdapp.tdapp",
      "adaptiveIcon": {
        "backgroundColor": "#faf9f4",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/splash-mark-light.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/brand/splash-mark-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tdapp.tdapp.widgets",
          "groupIdentifier": "group.com.tdapp.tdapp",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Tu día",
              "description": "Lo que sigue hoy y cuánto te queda.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "FocusWidget",
              "displayName": "Enfoque",
              "description": "El bloque de enfoque en curso, con la cuenta atrás.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "StreakWidget",
              "displayName": "Racha",
              "description": "Cuántos días seguidos cerraste algo.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "CaptureWidget",
              "displayName": "Anotar",
              "description": "Anota algo en un toque, sin abrir la app.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "android": null
            },
            {
              "name": "HeatWidget",
              "displayName": "Mapa de calor",
              "description": "Tu trimestre, semana a semana.",
              "supportedFamilies": [
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": true,
              "android": null
            }
          ]
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
