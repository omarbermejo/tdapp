# Solo variables EXPO_PUBLIC_* llegan al cliente (quedan visibles en el bundle, nunca secretos).
# Si la dejas vacia, la app usa el host del dev server de Expo en el puerto 3000.
EXPO_PUBLIC_API_URL=

# Client IDs de OAuth de Google (Google Cloud > Credenciales). No son secretos: viajan en el bundle.
# Ambos registrados con bundle id / package com.tdapp.tdapp.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
